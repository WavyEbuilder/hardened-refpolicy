policy_module(kscreenlocker)

##############################
#
# Declarations
#

attribute_role plasma_kscreenlocker_roles;

type plasma_kscreenlocker_t;
wayland_compositor_domain(plasma_kscreenlocker_t)

role plasma_kscreenlocker_roles types plasma_kscreenlocker_t;

type plasma_kscreenlocker_exec_t;
userdom_user_application_domain(plasma_kscreenlocker_t, plasma_kscreenlocker_exec_t)

type plasma_kscreenlocker_cache_t;
xdg_cache_content(plasma_kscreenlocker_cache_t)

##############################
#
# Local Policy
#
auth_use_pam(plasma_kscreenlocker_t)
systemd_dbus_chat_logind(plasma_kscreenlocker_t)

# For /etc/machine-id
files_read_etc_runtime_files(plasma_kscreenlocker_t)
miscfiles_read_localization(plasma_kscreenlocker_t)

manage_files_pattern(plasma_kscreenlocker_t, plasma_kscreenlocker_cache_t, plasma_kscreenlocker_cache_t)
manage_dirs_pattern(plasma_kscreenlocker_t, plasma_kscreenlocker_cache_t, plasma_kscreenlocker_cache_t)
xdg_cache_filetrans(plasma_kscreenlocker_t, plasma_kscreenlocker_cache_t, dir, "kscreenlocker_greet")

optional_policy(`
	devicekit_dbus_chat_power(plasma_kscreenlocker_t)
')
